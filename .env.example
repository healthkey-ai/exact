SECRET_KEY=change-me
# Default false — uncomment for local dev / debugging (#24).
# DEBUG=true
# ALLOWED_HOSTS must include your prod domain when DEBUG=false; the default
# localhost,127.0.0.1 is dev-only.
# ALLOWED_HOSTS=app.example.com,api.example.com
# CORS — pick one approach:
#   CORS_ALLOWED_ORIGINS: comma-separated allowlist (preferred for staging/prod)
#   CORS_ALLOW_ALL_ORIGINS=true: open everything (local dev only)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# CORS_ALLOW_ALL_ORIGINS=true
DATABASE_NAME=exact
DATABASE_USER=exact
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Required for compare / trials4patients scripts:
TRIALS_DATABASE_URL=postgresql://user:password@host:5432/dbname
PATIENT_DATABASE_URL=postgresql://user:password@host:5432/dbname

REDIS_URL=redis://localhost:6379
ENVIRONMENT=local

# PRomop service identity (docs/promop-service-identity.md). EXACT reads and
# never writes, so both scopes stay read-only. For the patient client set EITHER
# the static bearer OR the OAuth pair — a half-configured pair refuses every
# request, and OAuth wins whenever both are present. The vocabulary mirror is
# OAuth-only: it has no static-token setting.
# PROMOP_BASE=https://promop.example.com
# PROMOP_SERVICE_TOKEN=
# PROMOP_OAUTH_CLIENT_ID=
# PROMOP_OAUTH_CLIENT_SECRET=
# PROMOP_OAUTH_SCOPE=patient/*.read
# The vocabulary mirror is a SEPARATE service credential with its own scope:
# PROMOP_VOCAB_OAUTH_CLIENT_ID=
# PROMOP_VOCAB_OAUTH_CLIENT_SECRET=
# PROMOP_VOCAB_OAUTH_SCOPE=system/*.read

# PostGIS (if not in system PATH)
# macOS (Homebrew): GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
# macOS (Homebrew): GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib
# Linux:            GDAL_LIBRARY_PATH=/usr/lib/libgdal.so
# Linux:            GEOS_LIBRARY_PATH=/usr/lib/libgeos_c.so
